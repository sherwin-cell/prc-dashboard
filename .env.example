# Copy to .env and fill in. Vite only exposes variables prefixed with VITE_.

# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# blood_connect_backend URL. Optional in `npm run dev` (defaults to
# http://127.0.0.1:8000); required for production builds. The backend must
# list this portal's origin in ADMIN_CORS_ORIGINS.
VITE_API_BASE_URL=http://127.0.0.1:8000
